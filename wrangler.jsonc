// The hosting. Cloudflare Workers serves site/ exactly as committed, as static
// assets, with the headers site/_headers declares. CI deploys it, after every
// check has passed (.github/workflows/corpus.yml, `deploy`), and nothing
// builds on Cloudflare's side, so what it serves is what the checks judged.
{
  "name": "wherefore",
  // The Cloudflare account it deploys into. An identifier, not a credential:
  // the credential is CLOUDFLARE_API_TOKEN, a secret only CI holds.
  "account_id": "5aaa840c93c3fe89c9d9f883aa6e7b37",
  "compatibility_date": "2026-09-01",
  // The site's address is <name>.<account subdomain>.workers.dev until it has
  // a domain, and every preview's is <preview>-<name>.<subdomain>.workers.dev.
  // main's `wrangler deploy` applies both; before every preview, CI applies
  // them itself (.github/scripts/cloudflare_urls.py), since `wrangler preview`
  // does not.
  "workers_dev": true,
  "preview_urls": true,
  // The site's own address, a Custom Domain on the wherefore.build zone in
  // this account: Cloudflare makes its DNS record and its certificate itself.
  // main's `wrangler deploy` attaches it, and previews keep their workers.dev
  // addresses. getwherefore.com and wherefore.sh are not here: each redirects
  // to this one by a Redirect Rule in its own zone (README.md, "Hosting").
  "routes": [
    { "pattern": "wherefore.build", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site"
  },
  // `npx wrangler preview`, which builds every branch but main, refuses to run
  // without this block. It can stay empty: the assets above are the preview's
  // too.
  "previews": {}
}
